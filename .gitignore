# Raw USGS seismic hazard model
data/raw/usgs_nshm_conus_2018/

# Generated event catalogs and large calculation files
data/processed/event_catalogs/
*.hdf5
*.h5
*.parquet

# Python and Jupyter temporary files
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Official USGS calculation software downloaded by Notebook 2
/tools/usgs_nshmp/*.zip
/tools/usgs_nshmp/nshmp-haz-*/
/data/interim/usgs_rupture_rate_exports/
/data/processed/usgs_rupture_rates/
# Local enriched NSI exposure inventory
data/raw/exposure/seaside_nsi/*.xlsx

# Temporary and restartable metadata work directories
data/metadata/**/*_work/
data/metadata/**/inputs/
data/metadata/**/chunk_validation/
data/metadata/**/chunk_rupture_indices/

# Generated logs and API inspection files
data/metadata/**/*.log
data/metadata/nshmp_haz_2_6_5_api/
data/metadata/nshmp_haz_build_logs/
data/metadata/*_api.txt
data/metadata/*_inspection.txt

# Keep generated catastrophe-model outputs local
# The selected README PNGs are already tracked and will remain tracked
data/processed/**

# Java build and runtime artifacts
**/*.class
tools/**/classes/
tools/**/*_classes/
tools/**/*_arguments.txt
